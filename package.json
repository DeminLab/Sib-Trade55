{
  "name": "nextjs-ecommerce-starter",
  "version": "1.0.0",
  "description": "A free, production-ready Next.js ecommerce starter template built with Tailwind CSS and shadcn/ui.",
  "author": "Epic Design Labs <support@epicdesignlabs.com> (https://epicdesignlabs.com)",
  "license": "MIT",
  "homepage": "https://github.com/Epic-Design-Labs/nextjs-ecommerce-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/Epic-Design-Labs/nextjs-ecommerce-starter.git"
  },
  "keywords": [
    "nextjs",
    "ecommerce",
    "starter",
    "template",
    "tailwindcss",
    "shadcn-ui",
    "react",
    "typescript"
  ],
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset": "node scripts/create-admin.mjs reset",
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:next": "next dev --hostname 0.0.0.0",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.59.1",
    "shadcn": "4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
